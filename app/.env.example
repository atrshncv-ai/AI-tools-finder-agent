# Environment Variables
APP_ID=your_app_id
APP_SECRET=your_app_secret

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/science_agent
POSTGRES_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
# Server runtime
# PM2 sets NODE_ENV for the web process itself; the pipeline reads .env.
# PORT is the port the web process binds (nginx proxies to it on 127.0.0.1).
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Session lifetime of the dashboard JWT, hours.
SESSION_EXPIRY_HOURS=24
# Signing secret. When empty the code falls back to APP_SECRET (legacy name);
# set one of the two, both empty is a start-up error.
JWT_SECRET=
# User-Agent the collector and the LLM client send upstream.
AGENT_UA=science-agent/2.0

# CORS
CORS_ORIGIN=http://localhost:3000

# Kimi Platform Auth
KIMI_AUTH_URL=https://kimi.platform/api/auth
KIMI_OPEN_URL=https://kimi.platform/api/open

# Owner
OWNER_UNION_ID=

# ─────────────────────────────────────────────────────────────────────────────
# YouTube collection and the Whisper fallback for videos without captions.
# The fallback is off when no key is set: such a video is rejected, not retried.
# ─────────────────────────────────────────────────────────────────────────────
# How many /videos and /shorts items per channel the explicit tab crawl asks for.
YOUTUBE_TAB_ITEMS=3
WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo
# Any of the three enables the fallback; WHISPER_API_KEY wins.
WHISPER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional HTML fallback for pages the default extractor cannot read.
# Off unless explicitly enabled.
# ─────────────────────────────────────────────────────────────────────────────
SCRAPEGRAPH_ENABLED=
SCRAPEGRAPH_COMMAND=

# ─────────────────────────────────────────────────────────────────────────────
# GigaChat (primary LLM provider — relevance judging and summaries)
# Credentials are issued in the GigaChat developer console: client_id +
# client_secret for the "GIGACHAT_API_PERS" scope (individuals).
# Values are secrets: keep them only in .env, never in the repository.
# Empty value = the default baked into the provider code (shown in comments).
# Environment requirements, not code: a Russian IP and Russian root
# certificates must be installed on the host, otherwise the call fails.
# ─────────────────────────────────────────────────────────────────────────────
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Default: GIGACHAT_API_PERS
GIGACHAT_SCOPE=
# Default: GigaChat
GIGACHAT_MODEL=
# Default: https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_AUTH_URL=
# Default: https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_API_URL=
# Default: 120000
GIGACHAT_TIMEOUT_MS=

# ─────────────────────────────────────────────────────────────────────────────
# Opencode Zen API (fallback LLM provider when GigaChat is rate-limited/down;
# also the legacy cloud AI for summarization and title translation)
# ─────────────────────────────────────────────────────────────────────────────
ZEN_BASE_URL=https://opencode.ai/zen/v1
# Key pool (comma-separated) — automatic rotation on quota/balance exhaustion.
# Legacy single-key ZEN_API_KEY is still supported as a fallback.
ZEN_API_KEYS=your_zen_key_1,your_zen_key_2
# Single legacy key, used when the pool above is empty.
ZEN_API_KEY=
ZEN_KEY_COOLDOWN_MS=3600000
ZEN_MODEL=deepseek-v4-flash-free
# Comma-separated models tried when the pool of the current model is exhausted.
ZEN_FALLBACK_MODELS=

# ─────────────────────────────────────────────────────────────────────────────
# OpenCode Go endpoint (paid subscription — pipeline uses this when configured)
# Go models catalog (no auth needed): https://opencode.ai/zen/go/v1/models
# Pin the cheapest model before deploying:
#   cd app && npx tsx scripts/hermes/cheapest-go-model.ts
# ─────────────────────────────────────────────────────────────────────────────
# Single Go key, or comma-separated pool (same rotation semantics as legacy).
# ZEN_GO_API_KEYS wins when non-empty; ZEN_GO_API_KEY is the single-key fallback.
ZEN_GO_API_KEYS=
ZEN_GO_API_KEY=
ZEN_GO_BASE_URL=https://opencode.ai/zen/go/v1
ZEN_GO_MODEL=mimo-v2.5
# Optional global override/prefix for the required x-opencode-session header (Go routing + prompt caching).
ZEN_GO_SESSION_ID=

# Request limits
ZEN_TIMEOUT_MS=120000
ZEN_MAX_INPUT_TOKENS=6000
ZEN_SUMMARY_MAX_TOKENS=1024
ZEN_DETAILED_MAX_TOKENS=2048
ZEN_TRANSLATION_MAX_TOKENS=4096

# Retry configuration
ZEN_RETRIES=3
ZEN_RETRY_DELAY_MS=2000
ZEN_CONCURRENCY=3

# Circuit breaker (stops calling Zen after N consecutive failures)
ZEN_CIRCUIT_BREAKER_THRESHOLD=5
ZEN_CIRCUIT_BREAKER_RESET_MS=60000

# Linear worker: retry delay after a failed/incomplete daily cycle (ms).
# The pipeline publishes ONE release per UTC day; this value only paces retries.
# Default 600000 = 10 minutes.
LINEAR_WORKER_INTERVAL_MS=600000

# Hard daily publication budget: how many articles one release may contain.
# Allowed range 5..10, empty = 8. A value outside the range stops the pipeline
# at start-up instead of being silently clamped.
DAILY_BUDGET=

# Telegram digest (daily-digest.ts, cron 06:00)
# Client recipients (comma-separated): the clean digest only, no service lines.
TELEGRAM_CLIENT_CHAT_IDS=
# Owner recipients (comma-separated): a copy of the same clean digest plus the
# separate service report with counters, errors and rejection reasons.
TELEGRAM_OWNER_CHAT_IDS=
# Legacy shared list: used as client recipients when TELEGRAM_CLIENT_CHAT_IDS
# is empty. Legacy single TELEGRAM_CHAT_ID is supported as a fallback too.
TELEGRAM_CHAT_IDS=
TELEGRAM_CHAT_ID=
# Legacy single owner address, used when TELEGRAM_OWNER_CHAT_IDS is empty.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_TOKEN=
PAYMENT_MANAGER_CHAT_ID=
# Date when the current server payment period ends (YYYY-MM-DD).
PAYMENT_DUE_AT=2026-11-10
DIGEST_DASHBOARD_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Offsite database backup (scripts/backup-offsite.sh, cron 03:30 UTC)
# The dump is uploaded with rclone to an S3-compatible bucket OUTSIDE this
# server: a backup that stays on the host dies with the host (R03).
# Without all four required values the script fails loudly instead of
# "succeeding" with an empty file. Values are secrets: app/.env only.
# ─────────────────────────────────────────────────────────────────────────────
# https://s3.example.com (no bucket in the URL)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# Optional; defaults to us-east-1 when empty.
BACKUP_S3_REGION=
# Key prefix inside the bucket; defaults to news-agent.
BACKUP_S3_PREFIX=news-agent
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Where the last successful backup is recorded; defaults to
# $HOME/.news-agent/last-backup.json.
BACKUP_STATUS_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# Extra TLS trust anchors for the Node runtime (GigaChat on a Russian host).
# scripts/deploy/gigachat-certs.sh installs the Russian Trusted Root/Sub CA and
# prints this value; Node ignores the system store without it.
# ─────────────────────────────────────────────────────────────────────────────
NODE_EXTRA_CA_CERTS=
